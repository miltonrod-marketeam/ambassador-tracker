# No necesitas definir nada: la contraseña se crea en el primer uso.
# Opcional: APP_PASSWORD es un acceso de emergencia; no impide crear tu contraseña la primera vez.
APP_PASSWORD=
# Opcional: SESSION_SECRET fija la clave de sesión; si no, se genera sola.
SESSION_SECRET=
# Las agrega Vercel solo al conectar Redis (Upstash) y Blob:
# KV_REST_API_URL / KV_REST_API_TOKEN, BLOB_READ_WRITE_TOKEN
